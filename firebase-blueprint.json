{
  "entities": {
    "NewsPost": {
      "title": "NewsPost",
      "description": "Represents a published or pending news article card",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 2000 },
        "sourceChannel": { "type": "string", "maxLength": 200 },
        "sourceUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "publishedTime": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "breaking": { "type": "boolean" },
        "isExclusive": { "type": "boolean" },
        "fullContent": { "type": "string", "maxLength": 10000 },
        "district": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "summary", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and newsroom credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "username": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "tier": { "type": "string", "maxLength": 50 },
        "channelName": { "type": "string", "maxLength": 200 },
        "channelNameEn": { "type": "string", "maxLength": 200 },
        "channelLogoUrl": { "type": "string", "maxLength": 2000 },
        "channelLogoPngUrl": { "type": "string", "maxLength": 2000 },
        "channelLogoGifUrl": { "type": "string", "maxLength": 2000 },
        "channelLogoType": { "type": "string", "maxLength": 50 },
        "mobileNumber": { "type": "string", "maxLength": 50 },
        "district": { "type": "string", "maxLength": 200 },
        "avatarUrl": { "type": "string", "maxLength": 2000 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "isLocked": { "type": "boolean" },
        "isMobileLocked": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "DraftRecord": {
      "title": "DraftRecord",
      "description": "Saved news graphics and video drafts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "headline": { "type": "string", "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 2000 },
        "cardData": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "updatedAt"]
    },
    "SupportInquiry": {
      "title": "SupportInquiry",
      "description": "Customer support and inquiry requests",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userMobile": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 5000 },
        "voiceTranscript": { "type": "string", "maxLength": 5000 },
        "attachmentUrl": { "type": "string", "maxLength": 2000 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 },
        "adminResponse": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userEmail", "message", "createdAt"]
    }
  },
  "firestore": {
    "/news_posts/{postId}": {
      "schema": { "$ref": "#/entities/NewsPost" },
      "description": "Collection of all news posts across channels"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and permissions"
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": { "$ref": "#/entities/DraftRecord" },
      "description": "User saved drafts"
    },
    "/support_requests/{inquiryId}": {
      "schema": { "$ref": "#/entities/SupportInquiry" },
      "description": "User support inquiries and admin responses"
    }
  }
}
