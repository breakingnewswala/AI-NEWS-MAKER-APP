{
  "apphosting": {
    "backendId": "ainewsmakerapp",
    "rootDir": "/"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": false,
    "firestore": {
      "port": 8085,
      "host": "127.0.0.1"
    }
  }
}
